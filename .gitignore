*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
.env
.env.*
!.env.example

# Credentials and secrets
*.pem
*.p12
*.pfx
*.key
id_rsa*
*credentials*.json
*secrets*.json

# Windows and operating-system metadata
*:Zone.Identifier
Thumbs.db
.DS_Store

# Research sources requiring separate rights review
01_Raw_Data/
02_Merged_Data/
04_Elicit_Output/
07_Reference_Exports/
PhaseA_Source_Evidence/
PhaseB3_Primary_Sources/
**/Original_Source_Retrieval_v1/

